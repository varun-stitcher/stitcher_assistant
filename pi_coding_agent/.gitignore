# local launchers that carry credentials — never commit
run.local.sh
run_gateway.local.sh
stitcher_token.json
stitcher_auth_pending.json

# Dependencies
node_modules/
__pycache__/

# Logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
*.log
conversation-logs/

# Build output
dist/
build/
*.tsbuildinfo

# Test / coverage
coverage/
.nyc_output/

# Env / secrets (keep an .env.example if you add one)
.env
.env.*
!.env.example

# Authored configs written by the config_generation save_config tool
.output/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store

# package.json + package-lock.json ARE committed (do not ignore)
