## fine to save .env.local to repo, these are generic configurations

SWS_URL=https://app.local.stitcher.ai/v1
SWS_ADMIN_URL=https://app.local.stitcher.ai/v1/admin
SSL_CA_CERTIFICATE_PATH=/Users/vmittal/Code/stitcher-worktrees/fix-pi-agent/local/certs/ca.crt
LOG_LEVEL=info

AWS_PAIRING_ACCOUNT_ID=586677304463
GCP_SERVICE_ACCOUNT_PROJECT_ID=stitcher-dev-na-proj-auth
GCP_GKE_SERVICE_ACCOUNT_PROJECT_ID=stitcher-dev-na-r1-proj-srvcs
EXECUTOR=local
BASE_PATH=file://../../local/tmp_data/base
BASE_TEMP_PATH=file://../../../local/tmp_data/temp
LONG_TERM_STORAGE_BASE_PATH=file://../../local/tmp_data/long_term_storage
GCS_TEMP_PROXY_FOR_GCP_OPERATIONS=gs://stitcher-gcs-processing-bucket-dev-r1-na

K8S='{
    "workload_ns": "stitcher-ai-workloads",
    "k8s_executor_config_volume": "executor-config",
    "k8s_ca_secret_name": "stitcher-ai-ca",
    "worker_image": "us-east1-docker.pkg.dev/stitcher-ci-cd/stitcher-prod-repo/stitcher_operation_executor:0.3.2852.rc",
    "otel_image": "us-east1-docker.pkg.dev/stitcher-ci-cd/stitcher-prod-repo/otel-collector:0.10",
    "image_pull_policy": "Always",
    "temporalio_secret_cert_name": "temporal-namespace-tls",
    "github_token_secret_name": "github-token",
    "github_private_key_name": "github-app-secret",
    "llm_config_secret_api_key": "apikey",
    "llm_config_secret": "deepinfra-key"
}'

TEMPORAL_DSN=temporalio://local{NAMESPACE_SUFFIX}.id0qp.tmprl.cloud:7233
TEMPORAL_NAMESPACE=local{NAMESPACE_SUFFIX}.id0qp
TEMPORAL_CERT=../../local/temporal_certs/certificate.pem
TEMPORAL_PRIVATE_KEY=../../local/temporal_certs/private_key.pem

VAULT_ROLE_TEMPLATE_CLASS=sos
KEYCLOAK_URL=https://app.local.stitcher.ai
VAULT_URL=http://app.local.stitcher.ai:8200

# auth prefix
aws_role_name_suffix = "-dev-na"

# stitcher-index for loading llm index
base_path_stitcher_general_index_path=gs://stitcher-gcs-ai-model-bucket-dev-r1-na/models
stitcher_general_index_id=fb055b13-f924-4977-b2c5-f04a23cd31e3

otel_metric_endpoint=http://localhost:4317
gcp_project="stitcher-dev-na-r1-proj-srvcs"

# ------------------------------------------------------------------------------------------------
# Add to a new file named .env.local.dev (it is .gitignore'ed - so it will not get checked-in)
# ------------------------------------------------------------------------------------------------

# namespace should be - followed by initials of first and last names (e.g. Udam's is -ud)
#NAMESPACE_SUFFIX=-ud

# Creds for sos-sa (these will get set by the docker-compose)
#OPENID_SA_CLIENT_ID=sos-sa
#OPENID_SA_CLIENT_SECRET=

# Github app parameters
# GITHUB_APP_ID="xxxxxx"
# GITHUB_APP_INSTALL_URL=https://github.com/apps/<app_name>/installations/new/
# GITHUB_PRIVATE_KEY_PATH="../../local/github/gh_app_key.pem"
# WEBHOOK_SECRET="webhook-secret"

# DEV-ONLY: forces pipeline git source onto the named branch for standard runs.
# Leave unset for normal behavior (uses 'main'). Only honored when EXECUTOR=local
# and the run did not already specify a branch. Add to .env.local.dev (gitignored).
# DEV_FORCE_BRANCH=my-feature-branch
APP_BASE_URL=https://app.local.stitcher.ai
